---
# In your real fleet-config repo: copy this to config/vars/group/all/vault.yml,
# fill in real values, then encrypt it in place -- never commit the
# plaintext version:
#
#   cp vault.yml.example vault.yml
#   # edit vault.yml with real values
#   ansible-vault encrypt vault.yml
#
# reconcile.sh passes --vault-password-file automatically if a .vault_pass
# file exists at the root of your fleet-config repo; otherwise run
# ansible-playbook by hand with --ask-vault-pass.

# Shared between hosts/roles/arkeep_server and hosts/roles/arkeep_agent --
# every host must use the SAME value. Generate: openssl rand -hex 24
arkeep_agent_secret: CHANGEME

# arkeep_server only. Generate: openssl rand -hex 32
arkeep_secret_key: CHANGEME

# arcane_manager only. Generate: openssl rand -base64 32
arcane_encryption_key: CHANGEME

# semaphore only. Generate: openssl rand -base64 32 (admin password: your choice)
semaphore_admin_password: CHANGEME
semaphore_access_key_encryption: CHANGEME
