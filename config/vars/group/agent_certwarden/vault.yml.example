# Scope `agent_certwarden`: encrypted with vault id "agent_certwarden"; only hosts
# in the agent_certwarden group (the ones that fetch certificates) get its password.
# Create/edit with:  scripts/vault.sh edit agent_certwarden
#
# In Cert Warden's UI, each certificate has an API key and its private key has
# another. List both here per certificate name. (Several vault files in different
# groups may each define agent_certwarden_apikeys_<anything>; they are merged.)

agent_certwarden_apikeys:
  wildcard_example_com:
    cert: CHANGEME
    key: CHANGEME
