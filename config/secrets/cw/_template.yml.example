# Cert Warden API keys for ONE certificate. Copy to config/secrets/cw/<name>.yml via:
#   scripts/secrets.sh create cw.<name>      (e.g. cw._example.com)
# Scope cw.<name>. Only hosts with cert: [<name>] in hosts.yml can read this file
# (scripts/access.sh sync grants them).
# In Cert Warden: the certificate has an API key, and its private key has another.
cert: CHANGEME
key: CHANGEME
