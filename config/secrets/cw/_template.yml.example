# Cert Warden API keys for ONE certificate. Copy to config/secrets/cw/<name>.yml via:
#   scripts/vault.sh create cw.<name>      (e.g. cw._a64.one)
# Vault id: cw.<name>. Only hosts that list <name> in agent_certwarden_certs read
# this file, and only those need the password cw.<name>.
# In Cert Warden: the certificate has an API key, and its private key has another.
cert: CHANGEME
key: CHANGEME
