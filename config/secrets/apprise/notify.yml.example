# Secret apprise.notify (sops): where notifications go. Read by hosts with feat: [apprise]
# (also implied by feat: [apt_updates] / [compose_updates]). One Apprise URL per entry:
# https://github.com/caronc/apprise/wiki
#   scripts/secrets.sh create apprise.notify
apprise_notify_urls:
  - ntfys://CHANGEME-ntfy-host/CHANGEME-topic
