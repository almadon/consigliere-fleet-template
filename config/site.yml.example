---
# OPTIONAL. Rename to site.yml to take over "what runs" instead of the framework's
# default hosts/site.yml. Usually you don't need this: what a host runs comes from
# the tag manifests (config/tags/ and the framework's hosts/tags/). Use it for extra
# plays that tags can't express. Keep the fleet_plan play to still honour the tags.

- name: Baseline
  hosts: all
  become: true
  roles:
    - baseline
    - tailscale
    - docker

- name: Roles and tasks selected by tag manifests
  hosts: all
  become: true
  tasks:
    - ansible.builtin.include_role:
        name: fleet_plan

# - name: My extra play
#   hosts: util_my_tag          # any group from hosts.yml/groups.yml
#   become: true
#   roles:
#     - my_app                  # config/roles/my_app/ in this repo
